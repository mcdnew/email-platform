# .env.example (backend & SMTP & DB)

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://<USER>:<PASSWORD>@localhost:5432/email_platform
POSTGRES_USER=email_user
POSTGRES_PASSWORD=<strong-random-password>
POSTGRES_DB=email_platform

# ── SMTP ──────────────────────────────────────────────────────────────────────
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=<your-smtp-password>
# BCC all outgoing emails to this address (optional)
SMTP_BCC=

# ── Auth ──────────────────────────────────────────────────────────────────────
# API key for all backend endpoints (X-API-Key header) and the Next.js login page.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=<generate-a-strong-random-key>

# Dedicated secret for signing unsubscribe tokens. Keeping this separate from
# API_KEY means rotating API_KEY does not invalidate unsubscribe links in sent emails.
# Falls back to API_KEY if unset.
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
UNSUBSCRIBE_SECRET=<generate-a-strong-random-key>

# ── Scheduler ─────────────────────────────────────────────────────────────────
MAX_EMAILS_PER_DAY=100
TIMEZONE=Europe/Paris

# Max retry attempts for failed emails via POST /retry-failed (default: 3)
MAX_RETRIES=3

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level for app.* loggers: DEBUG, INFO, WARNING, ERROR (default: INFO)
LOG_LEVEL=INFO
# Path to the JSON log file (served by GET /error-log in DEV_MODE)
LOG_PATH=error_log.txt
