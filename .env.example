# .env.example (backend & SMTP & DB & UI password)

# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://<USER>:<PASSWORD>@localhost:5432/email_platform
POSTGRES_USER=email_user
POSTGRES_PASSWORD=<strong-random-password>
POSTGRES_DB=email_platform

# ── SMTP ──────────────────────────────────────────────────────────────────────
SMTP_SERVER=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=<your-smtp-password>

# ── Auth ──────────────────────────────────────────────────────────────────────
# API key for all backend endpoints (X-API-Key header)
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
API_KEY=<generate-a-strong-random-key>
# UI password for Streamlit
APP_PASSWORD=<your-UI-password>

# ── Scheduler ─────────────────────────────────────────────────────────────────
MAX_EMAILS_PER_DAY=100
TIMEZONE=Europe/Paris
