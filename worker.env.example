# Worker runtime environment for the outreach service, launched by the main
# docker-compose stack in this repository.

# Claude / Anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Gmail OAuth2
GMAIL_OAUTH_CLIENT_ID=
GMAIL_OAUTH_CLIENT_SECRET=

# Worker app / notifications
APP_BASE_URL=https://your-platform.example.com
ALERT_EMAIL=you@example.com
LOG_LEVEL=INFO

# Shared platform integration
CORE_PLATFORM_PUBLIC_URL=https://your-platform.example.com
CORE_PLATFORM_UNSUBSCRIBE_SECRET=<same-as-UNSUBSCRIBE_SECRET>

# Optional worker tuning
POLL_INTERVAL_MINUTES=15
GMAIL_DAILY_LIMIT=490
